{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg",
      "displayName": "VS + vcpkg toolchain (manifest)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "MATHFP_ENABLE_RANGES": "ON",
        "MATHFP_ENABLE_LINALG": "ON",
        "MATHFP_ENABLE_GRAPH": "ON",
        "MATHFP_ENABLE_INTEROP": "ON"
      }
    },
    {
      "name": "vcpkg-no-capacity-stages",
      "inherits": "vcpkg",
      "displayName": "VS + vcpkg, capacity stages disabled",
      "binaryDir": "${sourceDir}/out/build/vcpkg-no-capacity-stages",
      "cacheVariables": {
        "TIMETABLE_ENABLE_RUNTIME_OVERRIDES": "ON",
        "TIMETABLE_OVERRIDE_DISABLE_CAPACITY_AWARE_ASSIGNMENT": "ON",
        "TIMETABLE_OVERRIDE_DISABLE_VEHICLE_JOURNEY_ITEM_OVERLOAD_ASSESSMENT": "ON"
      }
    },
    {
      "name": "vcpkg-linux",
      "displayName": "WSL + vcpkg toolchain (manifest)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/vcpkg-linux",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "/home/kurai/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_MAKE_PROGRAM": "/usr/bin/ninja",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++",
        "MATHFP_ENABLE_RANGES": "ON",
        "MATHFP_ENABLE_LINALG": "ON",
        "MATHFP_ENABLE_GRAPH": "ON",
        "MATHFP_ENABLE_INTEROP": "ON"
      }
    },
    {
      "name": "vcpkg-linux-no-capacity-stages",
      "inherits": "vcpkg-linux",
      "displayName": "WSL + vcpkg, capacity stages disabled",
      "binaryDir": "${sourceDir}/out/build/vcpkg-linux-no-capacity-stages",
      "cacheVariables": {
        "TIMETABLE_ENABLE_RUNTIME_OVERRIDES": "ON",
        "TIMETABLE_OVERRIDE_DISABLE_CAPACITY_AWARE_ASSIGNMENT": "ON",
        "TIMETABLE_OVERRIDE_DISABLE_VEHICLE_JOURNEY_ITEM_OVERLOAD_ASSESSMENT": "ON"
      }
    },
    {
      "name": "code-intel",
      "displayName": "Code intelligence: MSVC + Ninja + vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/code-intel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TIMETABLE_BUILD_TESTS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vcpkg",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "vcpkg",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "configurePreset": "vcpkg",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "configurePreset": "vcpkg",
      "configuration": "Release"
    },
    {
      "name": "release-no-capacity-stages",
      "configurePreset": "vcpkg-no-capacity-stages",
      "configuration": "Release"
    },
    {
      "name": "wsl-debug",
      "configurePreset": "vcpkg-linux",
      "configuration": "Debug"
    },
    {
      "name": "wsl-release",
      "configurePreset": "vcpkg-linux",
      "configuration": "Release"
    },
    {
      "name": "wsl-release-no-capacity-stages",
      "configurePreset": "vcpkg-linux-no-capacity-stages",
      "configuration": "Release"
    },
    {
      "name": "code-intel",
      "configurePreset": "code-intel"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug tests",
      "configurePreset": "vcpkg",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release tests",
      "configurePreset": "vcpkg",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }, 
    {
      "name": "code-intel",
      "configurePreset": "code-intel",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
