{
  "version": 2,
  "configurePresets": [
    {
      "name": "vcpkg",
      "displayName": "VS + vcpkg toolchain (manifest)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",

        "MATHFP_ENABLE_RANGES": "ON",
        "MATHFP_ENABLE_LINALG": "ON",
        "MATHFP_ENABLE_GRAPH": "ON",
        "MATHFP_ENABLE_INTEROP": "ON"
      }
    },
    {
      "name": "vcpkg-linux",
      "displayName": "WSL + vcpkg toolchain (manifest)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/vcpkg-linux",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "/home/kurai/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",

        "CMAKE_MAKE_PROGRAM": "/usr/bin/ninja",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++",

        "MATHFP_ENABLE_RANGES": "ON",
        "MATHFP_ENABLE_LINALG": "ON",
        "MATHFP_ENABLE_GRAPH": "ON",
        "MATHFP_ENABLE_INTEROP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vcpkg",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "vcpkg",
      "configuration": "Release"
    },
    {
      "name": "wsl-debug",
      "configurePreset": "vcpkg-linux",
      "configuration": "Debug"
    },
    {
      "name": "wsl-release",
      "configurePreset": "vcpkg-linux",
      "configuration": "Release"
    }

  ]
}


